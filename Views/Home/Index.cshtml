@{
    ViewData["Title"] = "Home Page";
    var categories = (List<IETCD.Models.Category>)ViewBag.Categories;
    var featuredCourses = (List<IETCD.Models.Course>)ViewBag.FeaturedCourses;
    var sampleTags = (List<IETCD.Models.Tag>)ViewBag.SampleTags;
    var partners = new[] { "FJGS", "OSS", "KNES", "SES", "PCSC", "Gocle" };

    var categoryIcons = new Dictionary<string, string>
    {
        ["Information Technology (IT)"] = "&#128187;",
        ["Health"] = "&#10084;",
        ["Language"] = "&#128172;",
        ["Business"] = "&#128188;",
        ["Management"] = "&#128202;",
        ["Personal Development"] = "&#127793;",
        ["Sales & Marketing"] = "&#128227;",
        ["Engineering & Construction"] = "&#9881;",
        ["Teaching & Academics"] = "&#127891;"
    };

    var partnerColors = new[] { "#0D7364", "#F2A93B", "#1F2937", "#0D7364", "#F2A93B", "#1F2937" };
}

<!-- ================= HERO ================= -->
<section class="hero-section text-center">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>

    <div class="container py-5 position-relative">
        <h1 class="fw-bold text-white mb-3" style="font-size: 2.6rem; letter-spacing: -0.5px;">Free Online Courses With Certificates &amp; Diplomas</h1>
        <p class="text-white-50 mb-4" style="font-size: 1.05rem;">What do you want to learn today?</p>

        <form asp-controller="Courses" asp-action="Index" method="get" class="mx-auto" style="max-width: 580px;">
            <div class="search-glass">
                <span class="search-icon">&#128269;</span>
                <input type="text" class="search-input" placeholder="Search courses, e.g. Digital Marketing" />
                <button class="search-btn" type="submit">Search</button>
            </div>
        </form>
    </div>
</section>

<!-- ================= PARTNERS ================= -->
<section class="py-5 text-center" style="background-color: #FAFBFB;">
    <div class="text-uppercase small fw-semibold mb-2" style="color: var(--primary); letter-spacing: 2px;">Trusted Partners</div>
    <h4 class="fw-bold mb-5" style="color: var(--dark);">Learn From World Leading Experts</h4>
    <div class="d-flex flex-wrap justify-content-center align-items-center gap-4">
        @for (int i = 0; i < partners.Length; i++)
        {
            <div class="partner-card">
                <div class="partner-mark" style="background-color: @partnerColors[i % partnerColors.Length];">
                    @partners[i].Substring(0, 1)
                </div>
                <div class="partner-name">@partners[i]</div>
            </div>
        }
    </div>
</section>

<!-- ================= CATEGORIES (colored panel) ================= -->
<section class="py-5 px-4 my-5 category-panel">
    <h3 class="fw-bold text-white text-center mb-1">Explore Free Courses</h3>
    <p class="text-white-50 text-center mb-4">Browse by category to find what fits you</p>

    <div class="row g-3">
        @foreach (var cat in categories)
        {
            var icon = categoryIcons.ContainsKey(cat.Name) ? categoryIcons[cat.Name] : "&#128218;";
            <div class="col-6 col-md-4 col-lg-3">
                <a href="/Courses?categoryId=@cat.Id" class="text-decoration-none">
                    <div class="category-box">
                        <div class="category-icon">@Html.Raw(icon)</div>
                        <div class="fw-semibold" style="color: var(--dark);">@cat.Name</div>
                        <div class="small text-muted">@cat.Courses.Count(c => c.IsPublished) Courses &rarr;</div>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

<!-- ================= FEATURED COURSES ================= -->
<section class="py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="text-uppercase small fw-semibold mb-1" style="color: var(--primary); letter-spacing: 2px;">Fresh Picks</div>
            <h3 class="fw-bold m-0" style="color: var(--dark);">Featured Courses</h3>
        </div>
        <a href="/Courses" class="fw-semibold text-decoration-none" style="color: var(--primary);">View all &rarr;</a>
    </div>

    @if (!featuredCourses.Any())
    {
        <p class="text-muted">No courses published yet — add some from the Admin panel to feature them here.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var course in featuredCourses)
            {
                <div class="col-md-4">
                    <a href="/Courses/Details/@course.Id" class="text-decoration-none">
                        <div class="course-card h-100">
                            <div class="course-thumb">
                                <img src="@(string.IsNullOrEmpty(course.ThumbnailUrl) ? "https://placehold.co/400x220" : course.ThumbnailUrl)" alt="@course.Title" />
                                <span class="course-price-badge">Rs. @course.Price</span>
                            </div>
                            <div class="course-body">
                                <div class="course-category">@course.Category?.Name</div>
                                <h6 class="course-title">@course.Title</h6>
                                <div class="course-instructor">By @course.InstructorName</div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</section>

<!-- ================= SKILLS ================= -->
@if (sampleTags.Any())
{
    <section class="py-5 px-4 my-5 text-center skills-panel">
        <h3 class="fw-bold mb-4" style="color: var(--dark);">Learn In-demand Skills</h3>

        <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
            @foreach (var tag in sampleTags)
            {
                <a href="/Courses" class="tag-pill">@tag.Name</a>
            }
        </div>

        <a href="/Courses" class="fw-semibold text-decoration-none" style="color: var(--primary);">Browse all skills &rarr;</a>
    </section>
}

<style>
    /* ===== HERO ===== */
    .hero-section {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, var(--dark) 0%, var(--primary-dark) 55%, var(--primary) 100%);
        margin: 0 -12px;
        border-radius: 0 0 32px 32px;
    }

    .hero-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(60px);
        opacity: 0.35;
        pointer-events: none;
    }

    .hero-blob-1 {
        width: 300px;
        height: 300px;
        background: var(--accent);
        top: -100px;
        left: -80px;
    }

    .hero-blob-2 {
        width: 260px;
        height: 260px;
        background: #14B8A6;
        bottom: -100px;
        right: -60px;
    }

    .search-glass {
        display: flex;
        align-items: center;
        background: rgba(255,255,255,0.97);
        border-radius: 50px;
        padding: 6px 6px 6px 20px;
        box-shadow: 0 12px 32px rgba(0,0,0,0.25);
    }

    .search-icon {
        color: #9CA3AF;
        margin-right: 10px;
    }

    .search-input {
        flex: 1;
        border: none;
        outline: none;
        padding: 10px 0;
        font-size: 1rem;
        background: transparent;
    }

    .search-btn {
        border: none;
        background-color: var(--accent);
        color: white;
        font-weight: 600;
        padding: 10px 26px;
        border-radius: 40px;
        transition: filter 0.2s ease;
    }

        .search-btn:hover {
            filter: brightness(1.08);
        }

    /* ===== PARTNERS ===== */
    .partner-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        padding: 18px 24px;
        border-radius: 16px;
        background: white;
        border: 1px solid #EEF0F0;
        min-width: 120px;
        filter: grayscale(100%);
        opacity: 0.7;
        transition: all 0.3s ease;
    }

        .partner-card:hover {
            filter: grayscale(0%);
            opacity: 1;
            transform: translateY(-6px);
            box-shadow: 0 14px 28px rgba(13, 115, 100, 0.14);
            border-color: transparent;
        }

    .partner-mark {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 800;
        font-size: 1.3rem;
    }

    .partner-name {
        font-weight: 700;
        letter-spacing: 0.5px;
        color: var(--dark);
        font-size: 0.95rem;
    }

    /* ===== CATEGORY PANEL ===== */
    .category-panel {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
        border-radius: 24px;
        position: relative;
        overflow: hidden;
    }

    .category-box {
        background: white;
        border-radius: 14px;
        padding: 20px 16px;
        text-align: center;
        height: 100%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .category-box:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(0,0,0,0.18);
        }

    .category-icon {
        font-size: 1.8rem;
        margin-bottom: 8px;
    }

    /* ===== COURSE CARDS ===== */
    .course-card {
        border: 1px solid #E5E7EB;
        border-radius: 16px;
        overflow: hidden;
        background: var(--white);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

        .course-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 36px rgba(13, 115, 100, 0.18);
            border-color: var(--primary);
        }

    .course-thumb {
        position: relative;
        height: 160px;
        overflow: hidden;
    }

        .course-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

    .course-card:hover .course-thumb img {
        transform: scale(1.08);
    }

    .course-price-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background-color: var(--accent);
        color: white;
        font-weight: 600;
        font-size: 0.8rem;
        padding: 5px 12px;
        border-radius: 20px;
        box-shadow: 0 3px 10px rgba(242, 169, 59, 0.4);
    }

    .course-body {
        padding: 16px;
    }

    .course-category {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--primary);
        margin-bottom: 6px;
    }

    .course-title {
        font-weight: 700;
        color: var(--dark);
        margin-bottom: 4px;
    }

    .course-instructor {
        font-size: 0.85rem;
        color: #9CA3AF;
    }

    /* ===== SKILLS ===== */
    .skills-panel {
        background-color: var(--light-bg);
        border-radius: 24px;
    }

    .tag-pill {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 20px;
        border: 1px solid #E5E7EB;
        background: white;
        color: var(--dark);
        text-decoration: none;
        font-size: 0.88rem;
        transition: all 0.2s ease;
    }

        .tag-pill:hover {
            background-color: var(--primary);
            color: white;
            border-color: var(--primary);
            transform: translateY(-2px);
        }
</style>