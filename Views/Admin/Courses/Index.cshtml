@model IEnumerable<IETCD.Models.Course>

@{
    ViewData["Title"] = "Manage Courses";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Manage Courses
            </h1>

            <p class="text-muted mb-0">
                Create and manage courses
            </p>
        </div>

        <a href="/Admin/Courses/Create"
           class="btn"
           style="background-color: var(--primary); color:white;">
            + Create Course
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Instructor</th>
                            <th>Price</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var course in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @course.Title
                                    </strong>

                                    <div class="small text-muted">
                                        @course.Description
                                    </div>
                                </td>

                                <td>
                                    @course.InstructorName
                                </td>

                                <td>
                                    @course.Price
                                </td>

                                <td>
                                    @course.Category?.Name
                                </td>

                                <td>

                                    @if (course.IsPublished)
                                    {
                                        <span class="badge bg-success">
                                            Published
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Draft
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="d-flex gap-2">

                                        <a href="/Admin/Courses/Edit/@course.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <form method="post"
                                              action="/Admin/Courses/TogglePublish/@course.Id">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">
                                                @(course.IsPublished
                                                    ? "Unpublish"
                                                    : "Publish")
                                            </button>

                                        </form>

                                        <form method="post"
                                              action="/Admin/Courses/Delete/@course.Id"
                                              onsubmit="return confirm('Delete this course?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <h5>No courses yet</h5>

                    <p class="text-muted">
                        Create your first course.
                    </p>

                    <a href="/Admin/Courses/Create"
                       class="btn"
                       style="background-color: var(--primary); color:white;">
                        Create Course
                    </a>

                </div>
            }

        </div>

    </div>

</div>