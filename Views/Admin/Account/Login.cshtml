@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login - IETCD</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
            body {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(135deg, var(--dark) 0%, var(--primary-dark) 100%);
                margin: 0;
            }

            .admin-login-card {
                background: var(--white);
                border-radius: 12px;
                box-shadow: 0 20px 50px rgba(0,0,0,0.35);
                width: 100%;
                max-width: 400px;
                padding: 2.5rem;
            }

            .admin-badge {
                display: inline-block;
                background-color: var(--dark);
                color: var(--white);
                font-size: 0.7rem;
                font-weight: 600;
                letter-spacing: 1px;
                padding: 4px 12px;
                border-radius: 20px;
                margin-bottom: 1rem;
            }

            .admin-login-card h2 {
                color: var(--dark);
                font-weight: 700;
                margin-bottom: 0.25rem;
            }

            .admin-login-card p.subtitle {
                color: #6B7280;
                font-size: 0.9rem;
                margin-bottom: 1.75rem;
            }

            .form-control {
                padding: 0.65rem 0.9rem;
                border-radius: 8px;
                border: 1px solid #E5E7EB;
            }

                .form-control:focus {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 3px rgba(13, 115, 100, 0.15);
                }

            .btn-admin-login {
                background-color: var(--primary);
                color: var(--white);
                border: none;
                padding: 0.7rem;
                border-radius: 8px;
                font-weight: 600;
                width: 100%;
                margin-top: 0.5rem;
                transition: background-color 0.15s ease;
            }

                .btn-admin-login:hover {
                    background-color: var(--primary-dark);
                    color: var(--white);
                }

            .form-label {
                font-size: 0.85rem;
                font-weight: 600;
                color: var(--dark);
                margin-bottom: 0.35rem;
            }

            .lock-icon {
                width: 52px;
                height: 52px;
                border-radius: 50%;
                background-color: var(--light-bg);
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 1rem;
                font-size: 1.4rem;
                color: var(--primary);
            }
    </style>
</head>

<body>
    <div class="admin-login-card">
        <div class="text-center">
            <div class="lock-icon">&#128274;</div>
            <span class="admin-badge">ADMIN PORTAL</span>
            <h2>IETCD Admin</h2>
            <p class="subtitle">Sign in to manage courses, categories and content</p>
        </div>

        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

        <form method="post" action="/Admin/Account/Login">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email"
                       name="email"
                       class="form-control"
                       placeholder="admin@ietcd.com"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password"
                       name="password"
                       class="form-control"
                       placeholder="••••••••"
                       required />
            </div>

            <button type="submit" class="btn btn-admin-login">
                Sign In
            </button>
        </form>

        <div class="text-center mt-4">
            <a href="/" class="text-decoration-none small" style="color:#9CA3AF;">
                &larr; Back to website
            </a>
        </div>
    </div>
</body>
</html>