@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-dashboard">

    <!-- HEADER -->
    <div class="dashboard-header">

        <div>
            <h1>Admin Dashboard</h1>
            <p>Manage IETCD courses and content</p>
        </div>

        <form method="post"
              action="/Admin/Account/Logout"
              class="logout-form">

            @Html.AntiForgeryToken()

            <button type="submit" class="logout-btn">
                Logout
            </button>

        </form>

    </div>


    <!-- DASHBOARD CARDS -->
    <div class="dashboard-grid">

        <!-- COURSE MANAGEMENT -->
        <div class="dashboard-card">

            <div class="card-content">

                <h3>Course Management</h3>

                <p>
                    Create, edit, publish and delete IETCD courses.
                </p>

            </div>

            <a href="/Admin/Courses"
               class="card-button primary-button">
                Manage Courses
            </a>

        </div>


        <!-- CREATE COURSE -->
        <div class="dashboard-card">

            <div class="card-content">

                <h3>Create Course</h3>

                <p>
                    Add a new course with its title, description,
                    price, instructor, category and tags.
                </p>

            </div>

            <a href="/Admin/Courses/Create"
               class="card-button accent-button">
                + Create Course
            </a>

        </div>


        <!-- PUBLIC WEBSITE -->
        <div class="dashboard-card">

            <div class="card-content">

                <h3>Public Website</h3>

                <p>
                    Open the public IETCD website.
                </p>

            </div>

            <a href="/"
               class="card-button secondary-button">
                Visit Website
            </a>

        </div>

    </div>

</div>


<style>

    .admin-dashboard {
        padding: 40px 0 70px;
    }


    /* HEADER */

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
    }

        .dashboard-header h1 {
            margin: 0;
            font-size: 2.7rem;
            font-weight: 700;
            color: var(--dark);
        }

        .dashboard-header p {
            margin: 8px 0 0;
            font-size: 1.05rem;
            color: #64748B;
        }


    /* LOGOUT */

    .logout-btn {
        background: white;
        border: 1px solid #dc3545;
        color: #dc3545;
        padding: 10px 22px;
        border-radius: 8px;
        font-size: 1rem;
        cursor: pointer;
        transition: 0.2s;
    }

        .logout-btn:hover {
            background: #dc3545;
            color: white;
        }


    /* GRID */

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 28px;
        align-items: stretch;
    }


    /* ALL THREE CARDS */

    .dashboard-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.07);
        padding: 30px;
        min-height: 275px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .dashboard-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.10);
        }


    /* CARD CONTENT */

    .card-content h3 {
        margin: 0 0 14px;
        font-size: 1.55rem;
        font-weight: 700;
        color: var(--dark);
    }

    .card-content p {
        margin: 0;
        font-size: 1rem;
        line-height: 1.7;
        color: #64748B;
    }


    /* BUTTON */

    .card-button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 50px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 1rem;
        font-weight: 600;
        margin-top: 25px;
        transition: 0.2s;
    }


    /* GREEN */

    .primary-button {
        background: var(--primary);
        color: white;
    }

        .primary-button:hover {
            background: var(--primary-dark);
            color: white;
        }


    /* ORANGE */

    .accent-button {
        background: var(--accent);
        color: white;
    }

        .accent-button:hover {
            opacity: 0.9;
            color: white;
        }


    /* WHITE */

    .secondary-button {
        background: white;
        border: 1px solid #94a3b8;
        color: #64748B;
    }

        .secondary-button:hover {
            background: #f8fafc;
            color: var(--dark);
        }


    /* MOBILE */

    @@media (max-width: 900px) {

        .dashboard-grid {
            grid-template-columns: 1fr;
        }

        .dashboard-header {
            align-items: flex-start;
            gap: 20px;
        }
    }


    @@media (max-width: 576px) {

        .admin-dashboard {
            padding: 25px 10px;
        }

        .dashboard-header {
            flex-direction: column;
        }

            .dashboard-header h1 {
                font-size: 2rem;
            }
    }

</style>