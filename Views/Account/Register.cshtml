@{
    ViewData["Title"] = "Register";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h2 class="fw-bold mb-2">
                        Create Account
                    </h2>

                    <p class="text-muted">
                        Create your IETCD student account.
                    </p>

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <form method="post"
                          action="/Account/Register">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">
                                Email
                            </label>

                            <input type="email"
                                   name="email"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Password
                            </label>

                            <input type="password"
                                   name="password"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Confirm Password
                            </label>

                            <input type="password"
                                   name="confirmPassword"
                                   class="form-control"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn w-100"
                                style="background-color:var(--primary);color:white;">
                            Create Account
                        </button>

                    </form>

                    <div class="text-center mt-3">
                        Already have an account?
                        <a href="/Account/Login">
                            Login
                        </a>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>